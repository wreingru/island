{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/island-race-course/result.schema.json",
  "title": "Island race result row (one bot in one heat)",
  "type": "object",
  "required": ["schema_version", "run_id", "heat_id", "course_id", "course_version", "bot_model", "bot_slot", "seed",
               "node_splits", "total_time_s", "raw_time_s", "penalties", "bonuses", "status", "pi", "pi_session_ids",
               "node_tree", "commit_sha", "generated_at", "driver"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^irc-v[0-9]+-[a-z_]+-s[0-9]{3}-b[0-9]+$"},
    "heat_id": {"type": "string"},
    "course_id": {"type": "string"},
    "course_version": {"type": "integer", "minimum": 1},
    "bot_model": {"enum": ["beetle_walker", "flying_beetle", "triathlete", "wing_swarm", "curvity_scout", "seed_bot"]},
    "bot_slot": {"type": "integer", "minimum": 0},
    "bot_name": {"type": "string"},
    "seed": {"type": "integer", "minimum": 0},
    "release_offset_s": {"type": "number", "minimum": 0},
    "speed_studs_s": {"type": "number", "exclusiveMinimum": 0},
    "node_splits": {"type": "object", "required": ["N0", "N1", "N2", "N3", "N4", "N5", "N6", "N7"],
                    "propertyNames": {"pattern": "^N[0-9]+b?$"}, "additionalProperties": {"type": "number", "minimum": 0}},
    "total_time_s": {"type": "number"},
    "raw_time_s": {"type": "number", "minimum": 0},
    "penalties": {"type": "array", "items": {"$ref": "#/$defs/adjust"}},
    "bonuses": {"type": "array", "items": {"$ref": "#/$defs/adjust"}},
    "status": {"enum": ["finished", "rescued", "dnf"]},
    "pi": {"type": "object", "required": ["real", "llm", "session_id", "parent_session_id"],
           "properties": {"real": {"type": "boolean"}, "llm": {"type": "boolean"}, "pi_package": {"type": ["string", "null"]},
                          "session_id": {"type": "string"}, "session_file": {"type": ["string", "null"]},
                          "parent_session_id": {"type": "string"}, "parent_session_file": {"type": ["string", "null"]}}},
    "pi_session_ids": {"type": "array", "items": {"type": "string"}, "minItems": 2},
    "node_tree": {"type": "array", "minItems": 8, "items": {
      "type": "object",
      "required": ["node_id", "type", "parent_node_id", "child_node_ids", "mode", "entered_s", "split_s", "exited_s", "branch", "pi_entry_id", "pi_parent_entry_id"],
      "properties": {
        "node_id": {"type": "string", "pattern": "^N[0-9]+b?$"},
        "type": {"enum": ["start", "swim", "side_objective", "obstacle_lane", "hop", "gates", "loop", "climb", "finish"]},
        "parent_node_id": {"type": ["string", "null"]},
        "child_node_ids": {"type": "array", "items": {"type": "string"}},
        "mode": {"type": "string"},
        "entered_s": {"type": "number", "minimum": 0}, "split_s": {"type": "number", "minimum": 0}, "exited_s": {"type": "number", "minimum": 0},
        "penalties_s": {"type": "number"}, "bonus_s": {"type": "number"},
        "branch": {"type": "boolean"}, "rejoins": {"type": "string"},
        "pi_entry_id": {"type": ["string", "null"]}, "pi_parent_entry_id": {"type": ["string", "null"]},
        "notes": {"type": "object"}}}},
    "provenance": {"type": "object"},
    "commit_sha": {"type": "string", "minLength": 7},
    "generated_at": {"type": "string"},
    "driver": {"type": "string"}
  },
  "$defs": {"adjust": {"type": "object", "required": ["node", "reason", "s"],
            "properties": {"node": {"type": "string"}, "reason": {"type": "string"}, "s": {"type": "number", "minimum": 0}}}}
}
