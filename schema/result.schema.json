{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://example.invalid/island-race-course/result.schema.json",
 "title": "Island race result row v2 (one wing-swarm bot in one heat)",
 "type": "object",
 "required": [
  "schema_version",
  "run_id",
  "heat_id",
  "course_id",
  "course_version",
  "bot_model",
  "bot_slot",
  "seed",
  "node_splits",
  "total_time_s",
  "raw_time_s",
  "penalties",
  "bonuses",
  "status",
  "pi",
  "pi_session_ids",
  "node_tree",
  "commit_sha",
  "generated_at",
  "driver",
  "source",
  "boundary"
 ],
 "properties": {
  "schema_version": {
   "const": 1
  },
  "run_id": {
   "type": "string",
   "pattern": "^irc-v[0-9]+-[a-z_0-9]+-s[0-9]{3,4}-b[0-9]+$"
  },
  "heat_id": {
   "type": "string"
  },
  "course_id": {
   "const": "mesa-island-race-v2"
  },
  "course_version": {
   "const": 2
  },
  "bot_model": {
   "enum": [
    "wing_swarm"
   ]
  },
  "bot_slot": {
   "type": "integer",
   "minimum": 0
  },
  "bot_name": {
   "type": "string"
  },
  "seed": {
   "type": "integer",
   "minimum": 0
  },
  "release_offset_s": {
   "type": "number",
   "minimum": 0
  },
  "speed_studs_s": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "node_splits": {
   "type": "object",
   "required": [
    "N0"
   ],
   "propertyNames": {
    "pattern": "^N[0-6]$"
   },
   "additionalProperties": {
    "type": "number",
    "minimum": 0
   }
  },
  "total_time_s": {
   "type": "number"
  },
  "raw_time_s": {
   "type": "number",
   "minimum": 0
  },
  "penalties": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/adjust"
   }
  },
  "bonuses": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/adjust"
   }
  },
  "status": {
   "enum": [
    "finished",
    "dnf"
   ]
  },
  "pi": {
   "type": "object",
   "required": [
    "real",
    "llm",
    "session_id",
    "parent_session_id"
   ],
   "properties": {
    "real": {
     "type": "boolean"
    },
    "llm": {
     "type": "boolean"
    },
    "pi_package": {
     "type": [
      "string",
      "null"
     ]
    },
    "session_id": {
     "type": "string"
    },
    "session_file": {
     "type": [
      "string",
      "null"
     ]
    },
    "parent_session_id": {
     "type": "string"
    },
    "parent_session_file": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "pi_session_ids": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "minItems": 2
  },
  "node_tree": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "node_id",
     "type",
     "parent_node_id",
     "child_node_ids",
     "mode",
     "entered_s",
     "split_s",
     "exited_s",
     "branch",
     "pi_entry_id",
     "pi_parent_entry_id"
    ],
    "properties": {
     "node_id": {
      "type": "string",
      "pattern": "^N[0-6]$"
     },
     "type": {
      "enum": [
       "start",
       "obstacle_lane",
       "return_leg",
       "gust_shore",
       "climb",
       "finish"
      ]
     },
     "parent_node_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "child_node_ids": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "mode": {
      "type": "string"
     },
     "entered_s": {
      "type": "number",
      "minimum": 0
     },
     "split_s": {
      "type": "number",
      "minimum": 0
     },
     "exited_s": {
      "type": "number",
      "minimum": 0
     },
     "penalties_s": {
      "type": "number"
     },
     "bonus_s": {
      "type": "number"
     },
     "branch": {
      "type": "boolean"
     },
     "rejoins": {
      "type": "string"
     },
     "pi_entry_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "pi_parent_entry_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "notes": {
      "type": "object"
     }
    }
   }
  },
  "provenance": {
   "type": "object"
  },
  "commit_sha": {
   "type": "string",
   "minLength": 7
  },
  "generated_at": {
   "type": "string"
  },
  "driver": {
   "type": "string"
  },
  "source": {
   "enum": [
    "sim-v2",
    "clawblox-live"
   ],
   "description": "sim-v2: runner/squall_sim.py held-out evaluation heats (15 bots); clawblox-live: times read from the v2 Clawblox world's own node log (clawblox/race_live_v2.py, 5 bots)"
  },
  "dnf_at": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^N[0-6]$",
   "description": "node the bot was in (or last left) when it stopped; only for status dnf"
  },
  "in_world": {
   "type": "object",
   "description": "live-run details: port, speed_scale, gate log, laps, energy, driver notes"
  },
  "dnf_reason": {
   "enum": [
    "water",
    "energy",
    "cap",
    "fell"
   ],
   "description": "water: centre entered the bay (lost); energy: downed at E <= 0; cap: not at the summit by squall arrival + 60 s; fell: dropped off the island (live only)"
  },
  "boundary": {
   "type": "object",
   "required": [
    "energy_end",
    "outside_s",
    "exits"
   ],
   "properties": {
    "energy_end": {
     "type": "number"
    },
    "outside_s": {
     "type": "number",
     "minimum": 0
    },
    "exits": {
     "type": "integer",
     "minimum": 0
    },
    "heat_formation_breaks": {
     "type": "integer",
     "minimum": 0
    },
    "heat_gust_peak": {
     "type": [
      "number",
      "null"
     ]
    },
    "config": {
     "type": "object"
    }
   },
   "description": "squall-line metrics for this bot (energy left, seconds outside the disc, disc exits) and heat-level formation breaks"
  }
 },
 "$defs": {
  "adjust": {
   "type": "object",
   "required": [
    "node",
    "reason",
    "s"
   ],
   "properties": {
    "node": {
     "type": "string"
    },
    "reason": {
     "type": "string"
    },
    "s": {
     "type": "number",
     "minimum": 0
    }
   }
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "status": {
      "enum": [
       "finished",
       "rescued"
      ]
     }
    }
   },
   "then": {
    "properties": {
     "node_splits": {
      "required": [
       "N0",
       "N1",
       "N2",
       "N3",
       "N4",
       "N5",
       "N6"
      ]
     },
     "node_tree": {
      "minItems": 7
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "status": {
      "const": "dnf"
     }
    }
   },
   "then": {
    "required": [
     "dnf_at",
     "dnf_reason"
    ]
   }
  }
 ]
}